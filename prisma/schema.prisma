generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgeStageBasis {
  age
  reading_stage
}

enum AgeStageValue {
  age_2_3           @map("2_3")
  age_4_5           @map("4_5")
  age_6_8           @map("6_8")
  pre_reader
  emergent_reader
  early_independent
}

enum ShelfStatus {
  owned
  borrowed
  wishlist
}

enum ReadingEventType {
  finished
  reread
  stopped
  rejected
}

enum ReactionSubjectType {
  child
  caregiver
}

enum ReactionValue {
  love
  like
  not_for_me
  dislike
}

enum ReporterType {
  caregiver
  child_direct
  unknown_legacy
}

enum ReactionSourceType {
  quick_log
  reaction_correction
  correction_carry_forward
}

enum PreferenceKind {
  worked_for_us
}

enum ObservationSubjectType {
  child
  caregiver
  family_reference
}

enum PreferenceSourceType {
  explicit_preference
}

enum RequestReferencePurpose {
  more_like_this
}

enum AmendmentKind {
  retract
  replace
}

enum AgeRange {
  age_2_3 @map("2_3")
  age_4_5 @map("4_5")
  age_6_8 @map("6_8")
}

enum ReadingRelationshipCode {
  read_aloud
  reading_together
  some_independent
}

enum BookKindCode {
  funny
  informative
  fantasy
  rhyming
  interactive
  gentle_cozy
  longer_stories
  wordless_picture_led
}

enum TopicCode {
  children_general
  animals
  dinosaurs
  vehicles
  construction_vehicles
  space
  weather
  ocean
  feelings
  friendship
  music
  fairy_tales
  humor
  bedtime
}

enum CandidateSourceDisposition {
  resolved
  unverified_identity
  source_record_unavailable
  hydration_failed
}

enum CandidateEvaluationState {
  eligible
  excluded
}

enum CandidateExclusionReason {
  missing_required_metadata
  duplicate_canonical_work
  request_reference_work
}

enum CandidatePoolAttemptStatus {
  started
  sourced
  hydrated
  normalized
  deduplicated
  evaluated
  completed
  failed
}

model Household {
  id                                   String                                @id @default(cuid())
  createdAt                            DateTime                              @default(now()) @db.Timestamptz(3)
  updatedAt                            DateTime                              @updatedAt @db.Timestamptz(3)
  children                             ChildProfile[]
  familyBooks                          FamilyBook[]
  readingEvents                        ReadingEvent[]
  preferenceObservations               PreferenceObservation[]
  interestPhases                       InterestPhase[]
  recommendationRequests               RecommendationRequest[]
  librarySettings                      HouseholdLibrarySetting[]
  readingRelationshipPhases            ReadingRelationshipPhase[]
  bookKindPhases                       BookKindPhase[]
  interestTopicConfirmations           InterestTopicConfirmation[]
  interestTopicConfirmationRevocations InterestTopicConfirmationRevocation[]
  candidatePoolAttempts                CandidatePoolAttempt[]
  candidateSourceRecords               CandidateSourceRecord[]
  candidateEvaluations                 CandidateEvaluation[]
}

model ChildProfile {
  id                         String                      @id @default(cuid())
  householdId                String
  nickname                   String?                     @db.VarChar(80)
  ageStageBasis              AgeStageBasis?
  ageStageValue              AgeStageValue?
  ageRange                   AgeRange?
  contentPreferences         String?
  createdAt                  DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                    @updatedAt @db.Timestamptz(3)
  household                  Household                   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  readingEvents              ReadingEvent[]
  preferenceObservations     PreferenceObservation[]
  interestPhases             InterestPhase[]
  recommendationRequests     RecommendationRequest[]
  readingRelationshipPhases  ReadingRelationshipPhase[]
  bookKindPhases             BookKindPhase[]
  interestTopicConfirmations InterestTopicConfirmation[]
  candidatePoolAttempts      CandidatePoolAttempt[]

  @@unique([id, householdId])
  @@index([householdId])
}

model BookWork {
  id                     String                           @id @default(cuid())
  title                  String
  subtitle               String?
  authors                String
  description            String?
  subjects               String?
  series                 String?
  language               String?
  metadataProvider       String?
  metadataRecordId       String?
  metadataProvenance     String?
  createdAt              DateTime                         @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                         @updatedAt @db.Timestamptz(3)
  editions               BookEdition[]
  familyBooks            FamilyBook[]
  readingEvents          ReadingEvent[]
  preferenceObservations PreferenceObservation[]
  requestReferences      RecommendationRequestReference[]
  candidateSourceRecords CandidateSourceRecord[]
  candidateEvaluations   CandidateEvaluation[]

  @@unique([metadataProvider, metadataRecordId])
  @@index([title])
}

model BookEdition {
  id                 String              @id @default(cuid())
  workId             String
  isbn10             String?             @unique
  isbn13             String?             @unique
  publisher          String?
  publicationDate    String?
  format             String?
  pageCount          Int?
  coverSmallUrl      String?
  coverLargeUrl      String?
  metadataProvider   String?
  metadataRecordId   String?
  metadataProvenance String?
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  work               BookWork            @relation(fields: [workId], references: [id], onDelete: Restrict)
  familyBookLinks    FamilyBookEdition[]
  readingEvents      ReadingEvent[]

  @@unique([metadataProvider, metadataRecordId])
  @@index([workId])
}

model FamilyBook {
  id          String              @id @default(cuid())
  householdId String
  workId      String
  firstSeenAt DateTime            @default(now()) @db.Timestamptz(3)
  lastSeenAt  DateTime            @default(now()) @db.Timestamptz(3)
  addedVia    String
  shelfStatus ShelfStatus?
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  household   Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  work        BookWork            @relation(fields: [workId], references: [id], onDelete: Restrict)
  editions    FamilyBookEdition[]

  @@unique([id, householdId])
  @@unique([householdId, workId])
  @@index([householdId, lastSeenAt])
}

model FamilyBookEdition {
  id           String      @id @default(cuid())
  householdId  String
  familyBookId String
  editionId    String
  firstSeenAt  DateTime    @default(now()) @db.Timestamptz(3)
  lastSeenAt   DateTime    @default(now()) @db.Timestamptz(3)
  addedVia     String
  familyBook   FamilyBook  @relation(fields: [familyBookId, householdId], references: [id, householdId], onDelete: Cascade)
  edition      BookEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)

  @@unique([id, householdId])
  @@unique([familyBookId, editionId])
  @@index([householdId, familyBookId])
  @@index([editionId])
}

model ReadingEvent {
  id                      String                 @id @default(cuid())
  householdId             String
  childId                 String
  workId                  String
  editionId               String?
  eventType               ReadingEventType
  occurredAt              DateTime               @db.Timestamptz(3)
  context                 String?
  stopReason              String?
  notes                   String?
  clientMutationId        String                 @db.VarChar(120)
  createdAt               DateTime               @default(now()) @db.Timestamptz(3)
  household               Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  child                   ChildProfile           @relation(fields: [childId, householdId], references: [id, householdId], onDelete: Cascade)
  work                    BookWork               @relation(fields: [workId], references: [id], onDelete: Restrict)
  edition                 BookEdition?           @relation(fields: [editionId], references: [id], onDelete: Restrict)
  reactions               Reaction[]
  targetAmendment         ReadingEventAmendment? @relation("ReadingEventAmendmentTarget")
  replacementForAmendment ReadingEventAmendment? @relation("ReadingEventAmendmentReplacement")

  @@unique([id, householdId])
  @@unique([householdId, clientMutationId])
  @@index([householdId, occurredAt])
  @@index([householdId, childId, occurredAt])
  @@index([workId, occurredAt])
}

model Reaction {
  id                      String              @id @default(cuid())
  householdId             String
  readingEventId          String
  subjectType             ReactionSubjectType
  value                   ReactionValue
  declaredAt              DateTime            @db.Timestamptz(3)
  reporterType            ReporterType
  sourceType              ReactionSourceType
  sourceVersion           String              @db.VarChar(80)
  clientMutationId        String              @db.VarChar(120)
  createdAt               DateTime            @default(now()) @db.Timestamptz(3)
  readingEvent            ReadingEvent        @relation(fields: [readingEventId, householdId], references: [id, householdId], onDelete: Cascade)
  targetAmendment         ReactionAmendment?  @relation("ReactionAmendmentTarget")
  replacementForAmendment ReactionAmendment?  @relation("ReactionAmendmentReplacement")

  @@unique([id, householdId])
  @@unique([householdId, clientMutationId])
  @@index([householdId, readingEventId, subjectType])
}

model PreferenceObservation {
  id                      String                          @id @default(cuid())
  householdId             String
  childId                 String
  workId                  String
  kind                    PreferenceKind
  subjectType             ObservationSubjectType
  reporterType            ReporterType
  declaredAt              DateTime                        @db.Timestamptz(3)
  sourceType              PreferenceSourceType
  sourceVersion           String                          @db.VarChar(80)
  clientMutationId        String                          @db.VarChar(120)
  createdAt               DateTime                        @default(now()) @db.Timestamptz(3)
  household               Household                       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  child                   ChildProfile                    @relation(fields: [childId, householdId], references: [id, householdId], onDelete: Cascade)
  work                    BookWork                        @relation(fields: [workId], references: [id], onDelete: Restrict)
  targetAmendment         PreferenceObservationAmendment? @relation("PreferenceObservationAmendmentTarget")
  replacementForAmendment PreferenceObservationAmendment? @relation("PreferenceObservationAmendmentReplacement")

  @@unique([id, householdId])
  @@unique([householdId, clientMutationId])
  @@index([householdId, declaredAt])
  @@index([householdId, workId])
  @@index([householdId, childId, declaredAt])
}

model InterestPhase {
  id                      String                     @id @default(cuid())
  householdId             String
  childId                 String
  label                   String                     @db.VarChar(120)
  startedAt               DateTime                   @db.Timestamptz(3)
  declaredAt              DateTime                   @db.Timestamptz(3)
  reporterType            ReporterType
  sourceVersion           String                     @db.VarChar(80)
  clientMutationId        String                     @db.VarChar(120)
  createdAt               DateTime                   @default(now()) @db.Timestamptz(3)
  household               Household                  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  child                   ChildProfile               @relation(fields: [childId, householdId], references: [id, householdId], onDelete: Cascade)
  end                     InterestPhaseEnd?
  targetAmendment         InterestPhaseAmendment?    @relation("InterestPhaseAmendmentTarget")
  replacementForAmendment InterestPhaseAmendment?    @relation("InterestPhaseAmendmentReplacement")
  topicConfirmation       InterestTopicConfirmation?

  @@unique([id, householdId])
  @@unique([id, householdId, childId])
  @@unique([householdId, clientMutationId])
  @@index([householdId, childId, startedAt])
}

model InterestPhaseEnd {
  id               String        @id @default(cuid())
  householdId      String
  interestPhaseId  String        @unique
  endedAt          DateTime      @db.Timestamptz(3)
  declaredAt       DateTime      @db.Timestamptz(3)
  reporterType     ReporterType
  sourceVersion    String        @db.VarChar(80)
  clientMutationId String        @db.VarChar(120)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  interestPhase    InterestPhase @relation(fields: [interestPhaseId, householdId], references: [id, householdId], onDelete: Cascade)

  @@unique([id, householdId])
  @@unique([interestPhaseId, householdId])
  @@unique([householdId, clientMutationId])
  @@index([householdId, endedAt])
}

model RecommendationRequest {
  id                      String                           @id @default(cuid())
  householdId             String
  childId                 String
  requestedAt             DateTime                         @db.Timestamptz(3)
  ageStageBasis           AgeStageBasis?
  ageStageValue           AgeStageValue?
  evidenceSnapshotVersion String                           @default("request-evidence-v1") @db.VarChar(80)
  evidenceSnapshot        Json                             @db.JsonB
  clientMutationId        String                           @db.VarChar(120)
  createdAt               DateTime                         @default(now()) @db.Timestamptz(3)
  household               Household                        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  child                   ChildProfile                     @relation(fields: [childId, householdId], references: [id, householdId], onDelete: Cascade)
  references              RecommendationRequestReference[]
  candidatePoolAttempts   CandidatePoolAttempt[]

  @@unique([id, householdId])
  @@unique([id, householdId, childId])
  @@unique([householdId, clientMutationId])
  @@index([householdId, requestedAt])
  @@index([householdId, childId, requestedAt])
}

model RecommendationRequestReference {
  id               String                  @id @default(cuid())
  householdId      String
  requestId        String
  workId           String
  purpose          RequestReferencePurpose
  selectedAt       DateTime                @db.Timestamptz(3)
  sourceVersion    String                  @db.VarChar(80)
  clientMutationId String                  @db.VarChar(120)
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  request          RecommendationRequest   @relation(fields: [requestId, householdId], references: [id, householdId], onDelete: Cascade)
  work             BookWork                @relation(fields: [workId], references: [id], onDelete: Restrict)

  @@unique([id, householdId])
  @@unique([householdId, clientMutationId])
  @@unique([requestId, workId, purpose])
  @@index([householdId, requestId])
  @@index([workId])
}

model ReadingEventAmendment {
  id               String        @id @default(cuid())
  householdId      String
  kind             AmendmentKind
  targetId         String        @unique
  replacementId    String?       @unique
  declaredAt       DateTime      @db.Timestamptz(3)
  reporterType     ReporterType
  reasonCode       String?       @db.VarChar(80)
  clientMutationId String        @db.VarChar(120)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  target           ReadingEvent  @relation("ReadingEventAmendmentTarget", fields: [targetId, householdId], references: [id, householdId], onDelete: Cascade)
  replacement      ReadingEvent? @relation("ReadingEventAmendmentReplacement", fields: [replacementId, householdId], references: [id, householdId], onDelete: Cascade)

  @@unique([householdId, clientMutationId])
  @@unique([targetId, householdId])
  @@unique([replacementId, householdId])
  @@index([householdId, declaredAt])
}

model ReactionAmendment {
  id               String        @id @default(cuid())
  householdId      String
  kind             AmendmentKind
  targetId         String        @unique
  replacementId    String?       @unique
  declaredAt       DateTime      @db.Timestamptz(3)
  reporterType     ReporterType
  reasonCode       String?       @db.VarChar(80)
  clientMutationId String        @db.VarChar(120)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  target           Reaction      @relation("ReactionAmendmentTarget", fields: [targetId, householdId], references: [id, householdId], onDelete: Cascade)
  replacement      Reaction?     @relation("ReactionAmendmentReplacement", fields: [replacementId, householdId], references: [id, householdId], onDelete: Cascade)

  @@unique([householdId, clientMutationId])
  @@unique([targetId, householdId])
  @@unique([replacementId, householdId])
  @@index([householdId, declaredAt])
}

model PreferenceObservationAmendment {
  id               String                 @id @default(cuid())
  householdId      String
  kind             AmendmentKind
  targetId         String                 @unique
  replacementId    String?                @unique
  declaredAt       DateTime               @db.Timestamptz(3)
  reporterType     ReporterType
  reasonCode       String?                @db.VarChar(80)
  clientMutationId String                 @db.VarChar(120)
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)
  target           PreferenceObservation  @relation("PreferenceObservationAmendmentTarget", fields: [targetId, householdId], references: [id, householdId], onDelete: Cascade)
  replacement      PreferenceObservation? @relation("PreferenceObservationAmendmentReplacement", fields: [replacementId, householdId], references: [id, householdId], onDelete: Cascade)

  @@unique([householdId, clientMutationId])
  @@unique([targetId, householdId])
  @@unique([replacementId, householdId])
  @@index([householdId, declaredAt])
}

model InterestPhaseAmendment {
  id               String         @id @default(cuid())
  householdId      String
  kind             AmendmentKind
  targetId         String         @unique
  replacementId    String?        @unique
  declaredAt       DateTime       @db.Timestamptz(3)
  reporterType     ReporterType
  reasonCode       String?        @db.VarChar(80)
  clientMutationId String         @db.VarChar(120)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  target           InterestPhase  @relation("InterestPhaseAmendmentTarget", fields: [targetId, householdId], references: [id, householdId], onDelete: Cascade)
  replacement      InterestPhase? @relation("InterestPhaseAmendmentReplacement", fields: [replacementId, householdId], references: [id, householdId], onDelete: Cascade)

  @@unique([householdId, clientMutationId])
  @@unique([targetId, householdId])
  @@unique([replacementId, householdId])
  @@index([householdId, declaredAt])
}

model LibrarySystem {
  id                String                    @id @default(cuid())
  adapterId         String                    @unique
  displayName       String
  catalogBaseUrl    String?
  capabilities      String
  createdAt         DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                  @updatedAt @db.Timestamptz(3)
  householdSettings HouseholdLibrarySetting[]
}

model HouseholdLibrarySetting {
  id              String                   @id @default(cuid())
  householdId     String                   @unique
  librarySystemId String
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(3)
  household       Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  librarySystem   LibrarySystem            @relation(fields: [librarySystemId], references: [id], onDelete: Restrict)
  branches        HouseholdLibraryBranch[]

  @@unique([id, householdId])
}

model HouseholdLibraryBranch {
  id          String                  @id @default(cuid())
  householdId String
  settingId   String
  branchCode  String
  displayName String?
  setting     HouseholdLibrarySetting @relation(fields: [settingId, householdId], references: [id, householdId], onDelete: Cascade)

  @@unique([settingId, branchCode])
  @@index([householdId, settingId])
}

model ReadingRelationshipPhase {
  id                      String                             @id @default(cuid())
  householdId             String
  childId                 String
  code                    ReadingRelationshipCode
  startedAt               DateTime                           @db.Timestamptz(3)
  declaredAt              DateTime                           @db.Timestamptz(3)
  reporterType            ReporterType
  sourceVersion           String                             @db.VarChar(80)
  clientMutationId        String                             @db.VarChar(120)
  createdAt               DateTime                           @default(now()) @db.Timestamptz(3)
  household               Household                          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  child                   ChildProfile                       @relation(fields: [childId, householdId], references: [id, householdId], onDelete: Cascade)
  end                     ReadingRelationshipPhaseEnd?
  targetAmendment         ReadingRelationshipPhaseAmendment? @relation("ReadingRelationshipPhaseAmendmentTarget")
  replacementForAmendment ReadingRelationshipPhaseAmendment? @relation("ReadingRelationshipPhaseAmendmentReplacement")

  @@unique([id, householdId])
  @@unique([householdId, clientMutationId])
  @@index([householdId, childId, startedAt])
}

model ReadingRelationshipPhaseEnd {
  id                  String                   @id @default(cuid())
  householdId         String
  relationshipPhaseId String                   @unique
  endedAt             DateTime                 @db.Timestamptz(3)
  declaredAt          DateTime                 @db.Timestamptz(3)
  reporterType        ReporterType
  sourceVersion       String                   @db.VarChar(80)
  clientMutationId    String                   @db.VarChar(120)
  createdAt           DateTime                 @default(now()) @db.Timestamptz(3)
  phase               ReadingRelationshipPhase @relation(fields: [relationshipPhaseId, householdId], references: [id, householdId], onDelete: Cascade)

  @@unique([id, householdId])
  @@unique([relationshipPhaseId, householdId])
  @@unique([householdId, clientMutationId])
  @@index([householdId, endedAt])
}

model ReadingRelationshipPhaseAmendment {
  id               String                    @id @default(cuid())
  householdId      String
  kind             AmendmentKind
  targetId         String                    @unique
  replacementId    String?                   @unique
  declaredAt       DateTime                  @db.Timestamptz(3)
  reporterType     ReporterType
  reasonCode       String?                   @db.VarChar(80)
  clientMutationId String                    @db.VarChar(120)
  createdAt        DateTime                  @default(now()) @db.Timestamptz(3)
  target           ReadingRelationshipPhase  @relation("ReadingRelationshipPhaseAmendmentTarget", fields: [targetId, householdId], references: [id, householdId], onDelete: Cascade)
  replacement      ReadingRelationshipPhase? @relation("ReadingRelationshipPhaseAmendmentReplacement", fields: [replacementId, householdId], references: [id, householdId], onDelete: Cascade)

  @@unique([householdId, clientMutationId])
  @@unique([targetId, householdId])
  @@unique([replacementId, householdId])
  @@index([householdId, declaredAt])
}

model BookKindPhase {
  id                      String                  @id @default(cuid())
  householdId             String
  childId                 String
  code                    BookKindCode
  startedAt               DateTime                @db.Timestamptz(3)
  declaredAt              DateTime                @db.Timestamptz(3)
  reporterType            ReporterType
  sourceVersion           String                  @db.VarChar(80)
  clientMutationId        String                  @db.VarChar(120)
  createdAt               DateTime                @default(now()) @db.Timestamptz(3)
  household               Household               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  child                   ChildProfile            @relation(fields: [childId, householdId], references: [id, householdId], onDelete: Cascade)
  end                     BookKindPhaseEnd?
  targetAmendment         BookKindPhaseAmendment? @relation("BookKindPhaseAmendmentTarget")
  replacementForAmendment BookKindPhaseAmendment? @relation("BookKindPhaseAmendmentReplacement")

  @@unique([id, householdId])
  @@unique([householdId, clientMutationId])
  @@index([householdId, childId, startedAt])
}

model BookKindPhaseEnd {
  id               String        @id @default(cuid())
  householdId      String
  bookKindPhaseId  String        @unique
  endedAt          DateTime      @db.Timestamptz(3)
  declaredAt       DateTime      @db.Timestamptz(3)
  reporterType     ReporterType
  sourceVersion    String        @db.VarChar(80)
  clientMutationId String        @db.VarChar(120)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  phase            BookKindPhase @relation(fields: [bookKindPhaseId, householdId], references: [id, householdId], onDelete: Cascade)

  @@unique([id, householdId])
  @@unique([bookKindPhaseId, householdId])
  @@unique([householdId, clientMutationId])
  @@index([householdId, endedAt])
}

model BookKindPhaseAmendment {
  id               String         @id @default(cuid())
  householdId      String
  kind             AmendmentKind
  targetId         String         @unique
  replacementId    String?        @unique
  declaredAt       DateTime       @db.Timestamptz(3)
  reporterType     ReporterType
  reasonCode       String?        @db.VarChar(80)
  clientMutationId String         @db.VarChar(120)
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  target           BookKindPhase  @relation("BookKindPhaseAmendmentTarget", fields: [targetId, householdId], references: [id, householdId], onDelete: Cascade)
  replacement      BookKindPhase? @relation("BookKindPhaseAmendmentReplacement", fields: [replacementId, householdId], references: [id, householdId], onDelete: Cascade)

  @@unique([householdId, clientMutationId])
  @@unique([targetId, householdId])
  @@unique([replacementId, householdId])
  @@index([householdId, declaredAt])
}

model InterestTopicConfirmation {
  id               String                               @id @default(cuid())
  householdId      String
  childId          String
  interestPhaseId  String
  topicCode        TopicCode
  declaredAt       DateTime                             @db.Timestamptz(3)
  reporterType     ReporterType
  sourceVersion    String                               @db.VarChar(80)
  clientMutationId String                               @db.VarChar(120)
  createdAt        DateTime                             @default(now()) @db.Timestamptz(3)
  household        Household                            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  child            ChildProfile                         @relation(fields: [childId, householdId], references: [id, householdId], onDelete: Cascade)
  interestPhase    InterestPhase                        @relation(fields: [interestPhaseId, householdId, childId], references: [id, householdId, childId], onDelete: Cascade)
  revocation       InterestTopicConfirmationRevocation?

  @@unique([id, householdId])
  @@unique([interestPhaseId, householdId])
  @@unique([interestPhaseId, householdId, childId])
  @@unique([householdId, clientMutationId])
  @@index([householdId, childId])
}

model InterestTopicConfirmationRevocation {
  id               String                    @id @default(cuid())
  householdId      String
  childId          String
  confirmationId   String                    @unique
  reasonCode       String?                   @db.VarChar(80)
  declaredAt       DateTime                  @db.Timestamptz(3)
  reporterType     ReporterType
  clientMutationId String                    @db.VarChar(120)
  createdAt        DateTime                  @default(now()) @db.Timestamptz(3)
  household        Household                 @relation(fields: [householdId], references: [id], onDelete: Cascade)
  confirmation     InterestTopicConfirmation @relation(fields: [confirmationId, householdId], references: [id, householdId], onDelete: Cascade)

  @@unique([id, householdId])
  @@unique([confirmationId, householdId])
  @@unique([householdId, clientMutationId])
  @@index([householdId, childId])
}

model CandidatePoolAttempt {
  id                   String                     @id @default(cuid())
  householdId          String
  childId              String
  requestId            String
  attemptNumber        Int
  status               CandidatePoolAttemptStatus
  strategyVersion      String                     @db.VarChar(80)
  normalizationVersion String                     @db.VarChar(80)
  eligibilityVersion   String                     @db.VarChar(80)
  failureCode          String?                    @db.VarChar(80)
  coverageSummary      Json?                      @db.JsonB
  startedAt            DateTime                   @db.Timestamptz(3)
  completedAt          DateTime?                  @db.Timestamptz(3)
  createdAt            DateTime                   @default(now()) @db.Timestamptz(3)
  household            Household                  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  child                ChildProfile               @relation(fields: [childId, householdId], references: [id, householdId], onDelete: Cascade)
  request              RecommendationRequest      @relation(fields: [requestId, householdId, childId], references: [id, householdId, childId], onDelete: Cascade)
  sourceRecords        CandidateSourceRecord[]
  evaluations          CandidateEvaluation[]

  @@unique([id, householdId])
  @@unique([id, householdId, childId])
  @@unique([requestId, householdId, childId, attemptNumber])
  @@index([householdId, childId, requestId])
}

model CandidateSourceRecord {
  id                     String                      @id @default(cuid())
  householdId            String
  childId                String
  attemptId              String
  provider               String                      @db.VarChar(80)
  providerRecordId       String                      @db.VarChar(200)
  sourceCode             TopicCode
  providerResultPosition Int?
  resolvedWorkId         String?
  disposition            CandidateSourceDisposition
  createdAt              DateTime                    @default(now()) @db.Timestamptz(3)
  household              Household                   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  attempt                CandidatePoolAttempt        @relation(fields: [attemptId, householdId, childId], references: [id, householdId, childId], onDelete: Cascade)
  resolvedWork           BookWork?                   @relation(fields: [resolvedWorkId], references: [id], onDelete: SetNull)
  evaluationLinks        CandidateEvaluationSource[]

  @@unique([id, householdId])
  @@unique([id, householdId, childId, attemptId])
  @@unique([attemptId, householdId, childId, provider, providerRecordId, sourceCode])
  @@index([householdId, childId, attemptId])
}

model CandidateEvaluation {
  id              String                      @id @default(cuid())
  householdId     String
  childId         String
  attemptId       String
  workId          String
  state           CandidateEvaluationState
  exclusionReason CandidateExclusionReason?
  fieldCoverage   Json                        @db.JsonB
  dedupeEvidence  Json?                       @db.JsonB
  createdAt       DateTime                    @default(now()) @db.Timestamptz(3)
  household       Household                   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  attempt         CandidatePoolAttempt        @relation(fields: [attemptId, householdId, childId], references: [id, householdId, childId], onDelete: Cascade)
  work            BookWork                    @relation(fields: [workId], references: [id], onDelete: Restrict)
  sourceLinks     CandidateEvaluationSource[]

  @@unique([id, householdId])
  @@unique([id, householdId, childId, attemptId])
  @@unique([attemptId, householdId, childId, workId])
  @@index([householdId, childId, attemptId])
}

model CandidateEvaluationSource {
  evaluationId   String
  sourceRecordId String
  householdId    String
  childId        String
  attemptId      String
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  evaluation     CandidateEvaluation   @relation(fields: [evaluationId, householdId, childId, attemptId], references: [id, householdId, childId, attemptId], onDelete: Cascade)
  sourceRecord   CandidateSourceRecord @relation(fields: [sourceRecordId, householdId, childId, attemptId], references: [id, householdId, childId, attemptId], onDelete: Cascade)

  @@id([evaluationId, sourceRecordId])
  @@index([householdId, childId, attemptId])
}
