# Local-only PostgreSQL credentials used by compose.yaml. These are not hosted secrets.
DATABASE_URL="postgresql://bookkin_local:bookkin_local_only@127.0.0.1:5432/bookkin?schema=public"
TEST_DATABASE_URL="postgresql://bookkin_test:bookkin_test_only@127.0.0.1:5433/bookkin_test?schema=public"

# Keep this file safe to commit. Hosted credentials never belong here.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Checkpoint 7P protected preview only. Set this in the hosting platform's environment
# configuration, never in a committed file. Leaving it unset locally is correct and disables
# the gate; a HOSTED deployment without it refuses every request rather than exposing the app.
# BOOKKIN_PREVIEW_PASSPHRASE=
